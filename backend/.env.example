# -----------------------------------------------------------------------------
# Copy this file to `.env` and replace EVERY value. Do not commit real secrets.
#
# SECURITY NOTE: this repository previously contained a real Gmail app password
# and a real Django SECRET_KEY. Both have been scrubbed. If you ever copied the
# old .env.example values into a live account, ROTATE them now:
#   - Django SECRET_KEY: generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
#   - Gmail app password: revoke at https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------

# Django. Required in production (settings.py refuses to start without it when
# DEBUG=False). Generate a fresh value, never reuse the example below.
DJANGO_SECRET_KEY=replace-me-with-a-random-secret-key

# Optional: sign JWTs with a key distinct from the Django secret key.
JWT_SIGNING_KEY=

DEBUG=True
DJANGO_LOGLEVEL=info
# Comma-separated hosts allowed to serve the app. On Render this is set to the
# *.onrender.com domain; localhost is always permitted.
DJANGO_ALLOWED_HOSTS=localhost
# Frontend origin used to build password-reset email links.
FRONTEND_URL=http://localhost:3000

# Local `python manage.py` commands use SQLite by default. Docker Compose
# overrides this to `postgres` for the backend service.
DATABASE_MODE=sqlite
# On Render a PostgreSQL instance is attached and its connection string is
# injected as DATABASE_URL, which takes precedence over the discrete vars below.
# DATABASE_URL=postgres://user:password@host:5432/dbname
SQLITE_DATABASE_NAME=db.sqlite3

# Used only when DATABASE_MODE=postgres (including Docker Compose).
DATABASE_ENGINE=postgresql_psycopg2
DATABASE_NAME=vikoba-kidigitali-db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=password
DATABASE_HOST=db
DATABASE_PORT=5432

# Postgres specific variables for the db service
POSTGRES_DB=vikoba-kidigitali-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
# Google account used to send password-reset email (SMPT over TLS on port 587).
# Use an app password obtained from https://myaccount.google.com/apppasswords;
# store it in `.env`, NEVER in a committed file.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=replace-me-with-a-gmail-app-password